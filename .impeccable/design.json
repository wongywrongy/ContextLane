      "css": ".ds-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:34px;padding:0 12px;border:1px solid var(--stroke-2,rgba(255,255,255,.13));border-radius:8px;font:500 12.5px/1.5 var(--sans,Geist,sans-serif);cursor:pointer;background:transparent;border-color:transparent;color:var(--muted,#929eb2);}.ds-ghost:hover:enabled{background:var(--glass,rgba(255,255,255,.035));color:var(--text,#f2f4f8);}.ds-ghost:focus-visible{outline:2px solid var(--accent,#86aaff);outline-offset:3px}.ds-ghost:disabled{opacity:.45;cursor:not-allowed}"
