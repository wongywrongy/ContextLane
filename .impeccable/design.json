      "description": "Recessed content beneath a project row, with divided records.",
      "html": "<section class=\"ds-details\" aria-label=\"Project details\"><dl><div><dt>Path</dt><dd>\u2014</dd></div><div><dt>State</dt><dd>\u2014</dd></div></dl></section>",
      "css": ".ds-details{padding:14px 20px 18px 52px;border-top:1px solid var(--stroke,rgba(255,255,255,.075));background:rgba(0,0,0,.22);color:var(--text,#f2f4f8);font:13px/1.5 var(--sans,Geist,sans-serif)}.ds-details dl{margin:0;border:1px solid var(--stroke,rgba(255,255,255,.075));border-radius:10px;overflow:hidden}.ds-details dl>div{display:grid;grid-template-columns:110px minmax(0,1fr)}.ds-details dl>div+div{border-top:1px solid var(--stroke,rgba(255,255,255,.075))}.ds-details dt,.ds-details dd{margin:0;padding:10px 14px}.ds-details dt{color:var(--muted,#8e96a8)}.ds-details dd{border-left:1px solid var(--stroke,rgba(255,255,255,.075));font-family:var(--mono,monospace);overflow-wrap:anywhere}@media(max-width:1099px){.ds-details{padding:16px}}@media(prefers-reduced-motion:reduce){button,a,input{transition:none;animation:none}}"
    }
