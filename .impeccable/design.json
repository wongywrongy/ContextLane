      "html": "<button class=\"ds-secondary\">View logs</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:34px;padding:0 12px;border:1px solid var(--stroke-2,rgba(255,255,255,.13));border-radius:8px;font:500 12.5px/1.5 var(--sans,Geist,sans-serif);cursor:pointer;background:var(--glass-2,rgba(255,255,255,.06));color:var(--text,#f2f4f8);box-shadow:inset 0 1px 0 rgba(255,255,255,.07);}.ds-secondary:hover:enabled{background:var(--glass-3,rgba(255,255,255,.09));border-color:var(--stroke-3,rgba(255,255,255,.22));}.ds-secondary:focus-visible{outline:2px solid var(--accent,#86aaff);outline-offset:3px}.ds-secondary:disabled{opacity:.45;cursor:not-allowed}"
    },
