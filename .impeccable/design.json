      "refersTo": "status-working",
      "description": "Ready evidence label; demonstration only.",
      "html": "<span class=\"ds-pill\" aria-label=\"Ready\"><i aria-hidden=\"true\"></i>Ready</span>",
      "css": ".ds-pill{display:inline-flex;align-items:center;gap:7px;width:100%;max-width:230px;height:26px;padding:0 10px;border:1px solid;border-radius:999px;font:500 12.5px/1 var(--sans,Geist,sans-serif);white-space:nowrap}.ds-pill i{width:6px;height:6px;border-radius:50%;background:currentColor;flex-shrink:0}.ds-pill b{margin-left:auto;font:400 12px var(--mono,monospace)}.ds-pill{color:var(--ok,#3fe0a0);background:var(--ok-bg,rgba(63,224,160,.1));border-color:var(--ok-stroke,rgba(63,224,160,.28))}.ds-pill i{box-shadow:0 0 6px currentColor}@media(prefers-reduced-motion:reduce){button,a,input{transition:none;animation:none}}"
