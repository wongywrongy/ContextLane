      "description": "Projects and Settings in a recessed frame.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><button aria-current=\"page\">Projects</button><button>Settings</button></nav>",
      "css": ".ds-nav{display:inline-flex;gap:2px;padding:3px;border:1px solid var(--stroke,rgba(255,255,255,.075));border-radius:10px;background:var(--inset,rgba(0,0,0,.28))}.ds-nav button{min-height:32px;padding:0 12px;border:0;border-radius:7px;background:transparent;color:var(--muted,#8e96a8);font:500 13px var(--sans,Geist,sans-serif);cursor:pointer}.ds-nav button[aria-current]{background:var(--glass-3,rgba(255,255,255,.09));color:var(--text,#f2f4f8);box-shadow:inset 0 1px 0 rgba(255,255,255,.07),0 0 0 1px var(--stroke,rgba(255,255,255,.075))}.ds-nav button:hover{color:var(--text,#f2f4f8)}.ds-nav button:focus-visible{outline:2px solid var(--accent,#8b97ff);outline-offset:3px}"
    },
    {
      "name": "Observation Chip",
      "kind": "chip",
      "refersTo": "status-info",
      "description": "Noninteractive evidence label with an inline SVG symbol.",
      "html": "<span class=\"ds-chip\"><svg aria-hidden=\"true\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14m-5-5 5 5-5 5\"/></svg>Registered</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:6px;height:22px;padding:0 8px;border:1px solid var(--info-stroke,rgba(134,170,255,.26));border-radius:999px;background:var(--info-bg,rgba(134,170,255,.1));color:var(--info,#86aaff);font:500 11.5px/1 var(--sans,Geist,sans-serif);white-space:nowrap}"
    },
    {
      "name": "Filter Chip",
      "kind": "chip",
      "refersTo": "filter",
      "description": "Interactive list filter with selected count.",
      "html": "<button class=\"ds-filter\" aria-pressed=\"true\">All <b>3</b></button>",
      "css": ".ds-filter{display:inline-flex;align-items:center;gap:8px;min-height:32px;padding:0 12px;border:1px solid var(--stroke-2,rgba(255,255,255,.13));border-radius:999px;background:var(--glass-2,rgba(255,255,255,.06));color:var(--text,#f2f4f8);font:500 12.5px var(--sans,Geist,sans-serif);cursor:pointer;box-shadow:inset 0 1px 0 rgba(255,255,255,.07)}.ds-filter b{font:500 11px var(--mono,monospace);color:var(--accent,#8b97ff)}.ds-filter:hover{border-color:var(--stroke-3,rgba(255,255,255,.22))}.ds-filter:focus-visible{outline:2px solid var(--accent,#8b97ff);outline-offset:3px}"
    },
    {
      "name": "Project Glass Card",
      "kind": "card",
      "refersTo": "project-card",
      "description": "Shipped glass shell with header and inset summary.",
      "html": "<article class=\"ds-card\"><header><h2>Project</h2><p>/workspace/project</p></header><section>Nothing listening</section></article>",
      "css": ".ds-card{border:1px solid var(--stroke,rgba(255,255,255,.075));border-radius:20px;overflow:hidden;background:linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.02));color:var(--text,#f2f4f8);box-shadow:inset 0 1px 0 rgba(255,255,255,.07),0 20px 40px -24px rgba(0,0,0,.8);backdrop-filter:blur(18px) saturate(140%);transition:border-color .16s ease-out,box-shadow .16s ease-out}.ds-card:hover{border-color:var(--stroke-2,rgba(255,255,255,.13))}.ds-card header{padding:18px 20px 16px}.ds-card h2{margin:0;font:600 19px/1.5 var(--sans,Geist,sans-serif);letter-spacing:-.02em}.ds-card p{margin:6px 0 0;font:12px var(--mono,monospace);color:var(--muted,#8e96a8)}.ds-card section{padding:14px 20px 16px;border-top:1px solid var(--stroke,rgba(255,255,255,.075));background:var(--inset,rgba(0,0,0,.28));font:12.5px var(--sans,Geist,sans-serif);color:var(--faint,#929aad)}@media(prefers-reduced-motion:reduce){.ds-card{transition:none}}"
    },
    {
      "name": "Technology Tag",
      "kind": "chip",
      "refersTo": "technology-tag",
      "description": "Compact manifest label.",
      "html": "<span class=\"ds-tag\">Node</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;height:20px;padding:0 7px;border:1px solid var(--stroke,rgba(255,255,255,.075));border-radius:5px;background:var(--glass,rgba(255,255,255,.035));color:var(--text-2,#c9cfdb);font:500 11px var(--mono,monospace)}"
    }
  ],
  "narrative": {
    "northStar": "Signal",
    "overview": "Signal places clear project, runtime and URL observations on near-black glass. Soft violet and green ambient light, fine white borders, restrained inset highlights and a fading grid give the workspace depth without competing with its content. The user-pinned Signal HTML/CSS reference is the visual authority; the shipped React components and ordinary CSS define the implemented system.\n\nGeist provides compact interface text; Geist Mono distinguishes paths, ports, branches, times and counts. Explicit labels and inline SVG symbols describe observed state. The interface must preserve Rootlane’s trustworthy mapping and ownership boundaries rather than infer agent activity or service readiness.",
    "keyCharacteristics": [
      "Near-black glass with subtle atmospheric light and fine borders.",
      "Geist interface typography paired with Geist Mono technical metadata.",
      "Full-width project cards with aligned summary panels and inline detail tabs.",
      "Semantic state chips with explicit text and inline SVG symbols."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "Registered and Detected describe agent evidence; Listening describes a socket; Published describes a route. None is a claim of activity, completion or verified availability.",
        "section": "colors"
      },
      {
        "name": "The Technical Type Rule",
        "body": "Use Geist for interface language and Geist Mono for technical identifiers and observations; retain tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The Glass Rule",
        "body": "Use translucent gradients, thin borders and inset highlights together; keep ambient shadows soft and attached to glass surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do pair state color with an explicit label and an inline SVG symbol.",
      "Do preserve the three, two and one panel layouts at the shipped breakpoints.",
      "Do use locally hosted Geist and Geist Mono and preserve visible keyboard focus.",
      "Do keep details inline, technical tables horizontally scrollable and long values able to wrap.",
      "Do show stale observations and action failures beside the affected content."
    ],
    "donts": [
      "Don't infer activity from an agent registration, readiness from a listening port or HTTPS verification from a published route.",
      "Don't restore gray status dots or replace explicit state labels with color alone.",
      "Don't add account chrome, system-stat cards or editable Settings to this approved workspace.",
      "Don't introduce a UI dependency or fabricated vendor logo to reproduce the shipped patterns."
    ]
  }
}
