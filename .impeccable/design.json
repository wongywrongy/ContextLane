      "kind": "input",
      "refersTo": "search",
      "description": "Inset search with visible container focus.",
      "html": "<label class=\"ds-search\"><svg aria-hidden=\"true\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><circle cx=\"10\" cy=\"10\" r=\"6\"/><path d=\"m15 15 5 5\"/></svg><input aria-label=\"Search projects\" placeholder=\"Search name, branch, port\u2026\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:10px;height:38px;padding:0 6px 0 12px;border:1px solid var(--stroke,rgba(255,255,255,.075));border-radius:10px;background:var(--glass,rgba(255,255,255,.035));color:var(--muted,#929eb2);box-shadow:inset 0 1px 0 rgba(255,255,255,.07)}.ds-search:focus-within{border-color:var(--stroke-3,rgba(255,255,255,.22));background:var(--glass-2,rgba(255,255,255,.06))}.ds-search input{flex:1;min-width:0;border:0;outline:0;background:none;color:var(--text,#f2f4f8);font:13px var(--sans,Geist,sans-serif)}.ds-search input::placeholder{color:var(--muted,#929eb2)}"
    },
    {
      "name": "Segmented Navigation",
