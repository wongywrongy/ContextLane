      "description": "Shipped primary action style.",
      "html": "<button class=\"ds-primary\">Unlock</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:34px;padding:0 12px;border:1px solid var(--stroke-2,rgba(255,255,255,.13));border-radius:8px;font:500 12.5px/1.5 var(--sans,Geist,sans-serif);cursor:pointer;background:linear-gradient(180deg,#6b78ff,#5260f5);color:#fff;border-color:rgba(139,151,255,.55);box-shadow:inset 0 1px 0 rgba(255,255,255,.25),0 6px 20px -6px var(--accent-glow,rgba(91,104,255,.35));}.ds-primary:hover:enabled{background:linear-gradient(180deg,#7b87ff,#5d6bff);}.ds-primary:focus-visible{outline:2px solid var(--accent,#8b97ff);outline-offset:3px}.ds-primary:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){button,a,input{transition:none;animation:none}}"
