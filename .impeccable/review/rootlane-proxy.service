[Unit]
Description=Relay Rootlane's private proxy to its loopback backend
Requires=rootlane-proxy.socket
After=rootlane-proxy.socket

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=5min 127.0.0.1:9480
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
