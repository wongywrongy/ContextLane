{
  "name": "rootlane",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "build": "tsc && mkdir -p dist/state/migrations && cp src/state/migrations/*.sql dist/state/migrations/ && vite build && cp web/fonts/LICENSE.txt dist/web/Inter-LICENSE.txt",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "start": "node dist/main.js",
    "mcp": "node dist/mcp/main.js",
    "backup": "node dist/state/backup.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
