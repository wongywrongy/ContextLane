{
  "name": "@contextlanes/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The always-on service: lanes, event log, live stream and HTTP API.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "contextlanes-daemon": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --conditions=source src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@contextlanes/protocol": "workspace:*",
    "fastify": "5.12.5",
    "smol-toml": "1.9.1",
    "zod": "4.6.5"
  }
}
