{
  "name": "@contextlanes/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The always-on service: lanes, event log, live stream and HTTP API.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "contextlanes-daemon": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --conditions=source src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@contextlanes/protocol": "workspace:*",
    "@fastify/websocket": "11.3.4",
    "@simplewebauthn/server": "14.0.3",
    "fastify": "5.12.5",
    "pixelmatch": "7.1.0",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0",
    "smol-toml": "1.9.1",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.2"
  }
}
