{
  "name": "@contextlanes/lanehost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One small process per lane that holds the agent's ACP session and survives daemon restarts.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "contextlanes-lanehost": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.0.2",
    "@contextlanes/protocol": "workspace:*",
    "diff": "9.0.0",
    "zod": "4.6.5"
  }
}
