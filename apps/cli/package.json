{
  "name": "@contextlanes/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The contextlanes command: lanes, terminals, inbox and architecture from any terminal.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "contextlanes": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@contextlanes/protocol": "workspace:*",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/qrcode-terminal": "0.12.2"
  }
}
