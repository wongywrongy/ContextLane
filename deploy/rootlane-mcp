#!/bin/sh
set -eu
release=$(dirname "$(dirname "$(readlink -f "$0")")")
export ROOTLANE_PARENT_PID="$PPID"
rootlane_node=node
if [ -x "$release/runtime/node/bin/node" ]; then rootlane_node="$release/runtime/node/bin/node"; fi
exec "$rootlane_node" --input-type=module -e '
import { existsSync, readFileSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";
import { pathToFileURL } from "node:url";
const config = JSON.parse(readFileSync(process.env.ROOTLANE_CONFIG ?? join(homedir(), ".config/rootlane/config.json"), "utf8"));
process.env.ROOTLANE_URL = `http://127.0.0.1:${config.port}`;
process.env.ROOTLANE_AGENT_TOKEN = readFileSync(process.env.ROOTLANE_AGENT_CREDENTIAL_FILE ?? join(homedir(), ".config/rootlane/agent.credential"), "utf8").trim();
const adapter = existsSync(join(process.argv[1], "dist/mcp/standalone.cjs")) ? "dist/mcp/standalone.cjs" : "dist/mcp/main.js";
await import(pathToFileURL(join(process.argv[1], adapter)).href);
' "$release"
