# Replace the absolute checkout and Node paths before installing this template.
[Unit]
Description=Rootlane project catalog and environment service
After=network.target

[Service]
Type=exec
WorkingDirectory=/absolute/path/rootlane
ExecStart=/absolute/path/node /absolute/path/rootlane/dist/main.js
Environment=ROOTLANE_CONFIG=%h/.config/rootlane/config.json
Environment=ROOTLANE_OWNER_CREDENTIAL_FILE=%h/.config/rootlane/owner.credential
Environment=ROOTLANE_AGENT_CREDENTIAL_FILE=%h/.config/rootlane/agent.credential
Environment=ROOTLANE_INGEST_CREDENTIAL_FILE=%h/.config/rootlane/ingest.credential
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=120
KillMode=control-group

[Install]
WantedBy=default.target
