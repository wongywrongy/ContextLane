# Who owns your code on this machine:  id -u  and  id -g
PUID=1000
PGID=1000
TZ=UTC

# The folder that holds your repositories, and an (empty) folder for lane checkouts.
# Both are mounted at these same paths inside the container.
CONTEXTLANES_CODE=/home/you/code
CONTEXTLANES_LANES=/home/you/lanes

# Links from other devices: https://<service>-<n>-<project>.<domain>, and the web app at
# https://lanes.<domain>. Leave empty for this machine only (http://lanes.localhost:4601).
CONTEXTLANES_DOMAIN=

# Where the one port is published. For a reverse proxy in another container, 0.0.0.0:4601 or a
# shared network (docs/DOCKER.md).
CONTEXTLANES_PUBLISH=127.0.0.1:4601

# The name shown in the web app.
CONTEXTLANES_NAME=docker

# bwrap (default) hides ContextLanes' own data from agents. off only where bubblewrap cannot run.
CONTEXTLANES_SANDBOX=bwrap
